text = ""
undo_stack = []
redo_stack = []
while True:
    print("\n--- TEXT EDITOR MENU ---")
    print("1. Type text")
    print("2. Undo")
    print("3. Redo")
    print("4. Display text")
    print("5. Exit")
    choice = input("Enter your choice: ")
    if choice == "1":
        new_text = input("Enter text to add: ")
        undo_stack.append(text)
        text += new_text
        redo_stack.clear()
        print("Text added successfully!")
    elif choice == "2":
        if undo_stack:
            redo_stack.append(text)
            text = undo_stack.pop()
            print("Undo successful!")
        else:
            print("Nothing to undo.")
    elif choice == "3":
        if redo_stack:
            undo_stack.append(text)
            text = redo_stack.pop()
            print("Redo successful!")
        else:
            print("Nothing to redo.")
    elif choice == "4":
        print("Current Text:", text)
    elif choice == "5":
        print("Exiting Text Editor.")
        break
    else:
        print("Invalid choice! Please try again.")
